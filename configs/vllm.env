# vLLM serving settings (P4a). Edit here, not in the scripts.
CONDA_ENV=minal-vllm
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
SERVED_NAME=minal-llm
QUANTIZATION=awq_marlin
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.80
HOST=127.0.0.1
PORT=8000
# Set to 0 once VRAM is stable and you want CUDA graphs for speed.
ENFORCE_EAGER=1

# FlashInfer's sampler JIT-compiles with nvcc, which a plain conda/WSL setup lacks
# (symptom: "Could not find nvcc and default cuda_home='/usr/local/cuda'").
# 0 = use vLLM's built-in sampler instead. Set to 1 only after installing a CUDA toolkit.
VLLM_USE_FLASHINFER_SAMPLER=0
