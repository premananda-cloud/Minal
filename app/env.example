# Copy this file to .env and adjust as needed.
# .env is gitignored — .env.example is the tracked template.

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hermes3:8b
# Leave blank for local Ollama. Only set this if you put Ollama behind
# an auth proxy, or swap OLLAMA_HOST for a hosted/remote inference API.
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=60

# --- App server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Misc ---
LOG_LEVEL=info
